# Only public entry point. HTTPS is automatic for SITE_ADDRESS (a domain, or <ip-with-dashes>.sslip.io).
# The dashboard is public; Bull Board can clean/retry/delete jobs, so it stays behind basic auth.
{$SITE_ADDRESS} {
	encode gzip

	handle /admin/queues* {
		basic_auth {
			{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
		}
		reverse_proxy api:3000
	}
	# Public, read-only API reference (Scalar UI + the OpenAPI document).
	handle /docs* {
		reverse_proxy api:3000
	}
	handle /openapi.json {
		reverse_proxy api:3000
	}
	handle {
		reverse_proxy web:3001
	}
}
