# --- API ---
PORT=3000
# WEB_ORIGIN=http://localhost:3001
NODE_ENV=development
# ROLE=all                     # all | api | worker

# --- Infra (docker-compose defaults) ---
DATABASE_URL=postgresql://trawler:trawler@localhost:5432/trawler?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
# QUEUE_DRAIN_ON_BOOT=false

# --- Crawl ---
# WANTED_MAX_PAGES=3
# SARAMIN_MAX_PAGES=2
# PW_HEADLESS=true             # false = 브라우저 창 띄워서 디버깅
# PW_PROFILE_DIR=.data/pw-profile
# DEBUG_DIR=storage/debug
# CRAWL_CRON=*/30 * * * *
# CRAWL_ON_BOOT=false
# MAINTENANCE_CRON=15 3 * * *
# STALE_DAYS=14
# REPOST_WINDOW_DAYS=45

# --- Notifications ---
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# NOTIFY_MAX_PER_RUN=50
# NOTIFY_LOOKBACK_HOURS=24
# NOTIFY_REPOSTS=false
# ALERT_MIN_INTERVAL_MIN=360

# --- Dashboard auth (Clerk; web only) ---
# Reading is public. Change buttons ask for sign-in when pressed; only OWNER_EMAILS may change anything.
# Unset = open mode locally. In production, unset = every change is refused.
# For local dev put these in apps/web/.env.local (Next.js does not read this root file).
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# OWNER_EMAILS=you@example.com
