# --- API ---
PORT=3000
NODE_ENV=development
# ROLE=all                     # all | api | worker

# --- Infra (docker-compose defaults) ---
DATABASE_URL=postgresql://devilray:devilray@localhost:5432/devilray?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
