generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum JobSource {
  WANTED
  SARAMIN
}

enum Region {
  SEOUL
  GYEONGGI
  INCHEON
}

enum PostingStatus {
  ACTIVE
  EXPIRED
}

enum CrawlRunStatus {
  RUNNING
  OK
  FAILED
}

enum NotifyChannel {
  SLACK
  TELEGRAM
}

enum NotifyKind {
  NEW
  REPOST
}

/// A named set of keywords to crawl across one or more sources.
model SearchProfile {
  id        Int         @id @default(autoincrement())
  name      String      @unique
  keywords  String[]
  /// Title must contain one of these (case-insensitive). Empty = no constraint.
  includeTitle String[] @default([])
  /// Title containing any of these is dropped.
  excludeTitle String[] @default([])
  sources   JobSource[]
  /// Limit the site search to these regions. Empty = nationwide.
  regions   Region[]    @default([])
  enabled   Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  runs CrawlRun[]
}

/// One job posting as seen on a source. (source, externalId) is the dedup key.
model JobPosting {
  id          Int           @id @default(autoincrement())
  source      JobSource
  externalId  String
  title       String
  company     String
  location    String?
  url         String
  dueDate     DateTime?     @db.Date
  /// sha1(title|company|dueDate) — changes mean the posting was edited, not re-posted.
  contentHash String
  /// md5(normalized company|title). Same job re-registered under a new externalId shares it.
  fingerprint String
  /// Earlier posting with the same fingerprint seen within the repost window; such rows are not announced.
  repostOfId  Int?
  status      PostingStatus @default(ACTIVE)
  raw         Json
  firstSeenAt DateTime      @default(now())
  lastSeenAt  DateTime
  seen        Boolean       @default(false)
  starred     Boolean       @default(false)

  notifications NotificationLog[]

  @@unique([source, externalId])
  @@index([status, lastSeenAt])
  @@index([firstSeenAt])
  @@index([fingerprint])
  @@index([dueDate])
}

/// One execution of a crawl for (source, profile).
model CrawlRun {
  id         Int            @id @default(autoincrement())
  source     JobSource
  profileId  Int
  profile    SearchProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  startedAt  DateTime       @default(now())
  finishedAt DateTime?
  status     CrawlRunStatus @default(RUNNING)
  /// Raw count from the site before the title filter.
  fetched    Int            @default(0)
  found      Int            @default(0)
  inserted   Int            @default(0)
  updated    Int            @default(0)
  error      String?

  @@index([source, startedAt])
}

/// Used from Phase 2. Unique key guarantees a posting is never notified twice on one channel.
model NotificationLog {
  id        Int           @id @default(autoincrement())
  postingId Int
  posting   JobPosting    @relation(fields: [postingId], references: [id], onDelete: Cascade)
  channel   NotifyChannel
  kind      NotifyKind    @default(NEW)
  sentAt    DateTime      @default(now())
  ok        Boolean
  error     String?

  @@unique([postingId, channel, kind])
}
